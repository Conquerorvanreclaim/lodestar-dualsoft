<!-- The contents of this file will be loaded for each web application -->
<Context displayName="Welcome to betCockpit"
	cookies="true"
	useNaming="true"
	crossContext="false"
	reloadable="true">

    <!-- Default set of monitored resources. If one of these changes, the    -->
    <!-- web application will be reloaded.                                   -->
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>

    <!-- Uncomment this to disable session persistence across Tomcat restarts -->
    <!--
    <Manager pathname="" />

    -->
	
	<!-- ####################################### -->
	<!-- ### BEGIN SETTINGS STANDARD MANAGER ### -->
	<!-- ####################################### -->
	<Manager
			className="org.apache.catalina.session.StandardManager"
			distributable="true"
			algorithm="MD5"
			checkInterval="60"
			maxActiveSessions="-1"
			pathname="SESSIONS.ser"
			randomClass="java.security.SecureRandom">
	</Manager>
	<!-- ##################################### -->
	<!-- ### end settings standard manager ### -->
	<!-- ##################################### -->


	<!-- ################################################# -->
	<!-- ### BEGIN SETTINGS FOR CONTEXT ACCESSLOGVALVE ### -->
	<!-- ################################################# -->
	<Valve
			className="org.apache.catalina.valves.AccessLogValve"
			directory="logs"
			prefix="cockpit_access_log."
			suffix=".txt"
         	pattern="%a %l %u %t &quot;%r&quot; %s %b %D %{X-Forwarded-For}i"
			fileDateFormat="yyyy-MM-dd"
         	resolveHosts="false"
         	rotatable="true">
	</Valve>
	<!-- ############################################### -->
	<!-- ### end settings for context accesslogvalve ### -->
	<!-- ############################################### -->


	<!-- ################################################ -->
	<!-- ### BEGIN SETTINGS FOR JNDI DataSource REALM ### -->
	<!-- ################################################ -->
	<Parameter name="useEpasswd" value="true" />

	<Realm
      		className="org.apache.catalina.realm.DataSourceRealm"
      		dataSourceName="jdbc/BetDB"
			localDataSource="true"
			roleNameCol="web_role"
			userCredCol="e_passwd"
			userNameCol="user_name"
			userRoleTable="korisnik_web_roles"
			userTable="korisnik">
		<CredentialHandler
			className="org.apache.catalina.realm.MessageDigestCredentialHandler"
			algorithm="md5"
			encoding="utf8"
			iterations="1"
			saltLength="0">
		</CredentialHandler>
	</Realm>
	<!-- ############################################## -->
	<!-- ### end settings for jndi datasource realm ### -->
	<!-- ############################################## -->


	<!-- ####################################### -->
	<!-- ### BEGIN SETTINGS FOR COMMONS POOL ### -->
	<!-- ####################################### -->
	<Resource
		type="javax.sql.DataSource"
		auth="Container"
		name="jdbc/BetDB"
			factory="org.apache.commons.dbcp.BasicDataSourceFactory"
			driverClassName="oracle.jdbc.driver.OracleDriver"
			url="jdbc:oracle:thin:@//db-ct-scan.pionir.io:1521/piodb1.pionir.io"
			username="${database.username}"
			password="${database.password}"
			connectionProperties="defaultRowPrefetch=1000"
			initialSize="1"
			maxActive="16"
			maxIdle="3"
			minIdle="1"
			maxWait="10000"
			testOnBorrow="true"
			validationQuery="SELECT COUNT(*) FROM KORISNIK"
			logAbandoned="true"
			removeAbandoned="true"
			removeAbandonedTimeout="30"
			poolPreparedStatements="false"
			timeBetweenEvictionRunsMillis="900000"
	>
	</Resource>
	<!-- ##################################### -->
	<!-- ### end settings for commons pool ### -->
	<!-- ##################################### -->
  
 
	
</Context>
